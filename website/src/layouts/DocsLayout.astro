---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

interface NavItem {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  section: 'intro' | 'how-to' | 'status';
  prev?: NavItem;
  next?: NavItem;
}

const { title, description, section, prev, next } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const activeNav = section === 'status' ? 'status' : section;
---
<BaseLayout title={title} description={description} activeNav={activeNav}>
  <div class="docs-shell">
    <Sidebar currentPath={currentPath} />
    <main class="docs-main">
      <div class="docs-content">
        <slot />

        {(prev || next) && (
          <nav class="docs-pagination" aria-label="Page navigation">
            {prev && (
              <a href={prev.href} class="pagination-link pagination-prev">
                <span class="pagination-dir">← Previous</span>
                <span class="pagination-title">{prev.title}</span>
              </a>
            )}
            <div class="pagination-spacer"></div>
            {next && (
              <a href={next.href} class="pagination-link pagination-next">
                <span class="pagination-dir">Next →</span>
                <span class="pagination-title">{next.title}</span>
              </a>
            )}
          </nav>
        )}
      </div>
    </main>
  </div>
</BaseLayout>

<style>
.docs-shell {
  display: flex;
  min-height: 100vh;
  padding-top: 72px;
}
.docs-main {
  flex: 1;
  min-width: 0;
  margin-left: 260px;
}
.docs-content {
  max-width: 780px;
  margin: 0 auto;
  padding: 56px 40px 100px;
}

/* ── Typography ── */
.docs-content :global(h1) {
  font-size: 38px;
  font-weight: 800;
  letter-spacing: -1.5px;
  margin-bottom: 12px;
  color: #f1f5f9;
  line-height: 1.1;
}
.docs-content :global(.page-meta) {
  font-size: 15px;
  color: #475569;
  margin-bottom: 40px;
  padding-bottom: 32px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.docs-content :global(h2) {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.5px;
  margin-top: 52px;
  margin-bottom: 16px;
  color: #e2e8f0;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.docs-content :global(h3) {
  font-size: 17px;
  font-weight: 700;
  margin-top: 32px;
  margin-bottom: 12px;
  color: #cbd5e1;
}
.docs-content :global(h4) {
  font-size: 12px;
  font-weight: 700;
  margin-top: 28px;
  margin-bottom: 8px;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 1.5px;
}
.docs-content :global(p) {
  font-size: 15px;
  color: #94a3b8;
  line-height: 1.8;
  margin-bottom: 16px;
}
.docs-content :global(p strong), .docs-content :global(li strong) {
  color: #e2e8f0;
  font-weight: 600;
}
.docs-content :global(ul), .docs-content :global(ol) {
  padding-left: 24px;
  margin-bottom: 20px;
}
.docs-content :global(li) {
  font-size: 15px;
  color: #94a3b8;
  line-height: 1.8;
  margin-bottom: 6px;
}
.docs-content :global(code) {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12.5px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.08);
  padding: 2px 6px;
  border-radius: 4px;
  color: #fb923c;
}
.docs-content :global(pre) {
  background: #0f172a;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  padding: 20px;
  overflow-x: auto;
  margin: 24px 0;
}
.docs-content :global(pre code) {
  background: none;
  border: none;
  padding: 0;
  color: #e2e8f0;
  font-size: 13px;
  line-height: 1.7;
}
.docs-content :global(table) {
  width: 100%;
  border-collapse: collapse;
  margin: 24px 0;
  font-size: 14px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  overflow: hidden;
}
.docs-content :global(th) {
  text-align: left;
  padding: 10px 16px;
  background: rgba(255,255,255,0.03);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  color: #475569;
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.docs-content :global(td) {
  padding: 10px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  color: #94a3b8;
  vertical-align: top;
}
.docs-content :global(td:first-child) { color: #e2e8f0; font-weight: 500; }
.docs-content :global(tr:last-child td) { border-bottom: none; }
.docs-content :global(a):not([class]) {
  color: #f97316;
  border-bottom: 1px solid rgba(249,115,22,0.3);
  transition: border-color 0.2s;
}
.docs-content :global(a):not([class]):hover { border-color: #f97316; }
.docs-content :global(hr) {
  border: none;
  border-top: 1px solid rgba(255,255,255,0.06);
  margin: 40px 0;
}

/* ── Step Numbers ── */
.docs-content :global(.step) {
  display: flex;
  gap: 20px;
  margin-bottom: 32px;
}
.docs-content :global(.step-num) {
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(249,115,22,0.12);
  border: 1px solid rgba(249,115,22,0.25);
  color: #f97316;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2px;
}
.docs-content :global(.step-body h3) {
  margin-top: 0;
  font-size: 16px;
  color: #e2e8f0;
}

/* ── Pagination ── */
.docs-pagination {
  display: flex;
  gap: 16px;
  margin-top: 64px;
  padding-top: 32px;
  border-top: 1px solid rgba(255,255,255,0.06);
}
.pagination-spacer { flex: 1; }
.pagination-link {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 16px 20px;
  background: rgba(255,255,255,0.025);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  transition: all 0.2s;
  min-width: 180px;
  text-decoration: none !important;
  border-bottom: 1px solid rgba(255,255,255,0.06) !important;
}
.pagination-link:hover {
  background: rgba(255,255,255,0.05);
  border-color: rgba(249,115,22,0.3) !important;
  transform: translateY(-2px);
}
.pagination-next { text-align: right; }
.pagination-dir  { font-size: 12px; color: #475569; font-weight: 500; }
.pagination-title { font-size: 14px; color: #e2e8f0; font-weight: 600; }

/* ── Responsive ── */
@media (max-width: 1024px) {
  .docs-main { margin-left: 0; }
  .docs-content { padding: 40px 24px 80px; }
}
@media (max-width: 600px) {
  .docs-pagination { flex-direction: column; }
  .pagination-next { text-align: left; }
}
</style>
