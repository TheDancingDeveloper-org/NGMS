# Stage 1: Build Rust binary
FROM rust:1.88-bookworm AS builder
WORKDIR /build
COPY . .
RUN cargo build --release -p ngms-bootstrap

# Stage 2: Runtime (LinuxServer base for PUID/PGID support)
FROM ghcr.io/linuxserver/baseimage-debian:bookworm

LABEL org.opencontainers.image.source="https://github.com/AusAgentSmith-org/NGMS"
LABEL org.opencontainers.image.description="NGMS Bootstrap — discovery/rendezvous node"

COPY --from=builder /build/target/release/ngms-bootstrap /usr/local/bin/ngms-bootstrap

# s6 service definition
COPY docker/root-bootstrap/ /

EXPOSE 7890

VOLUME /config
