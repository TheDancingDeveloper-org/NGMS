{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 6am on Monday"
  ],
  "packageRules": [
    {
      "description": "Keep published download engines on exact, reviewed pins",
      "matchDatasources": ["crate"],
      "matchPackageNames": [
        "/^nzb-/",
        "/^nzbdav-/",
        "/^swarmforge/"
      ],
      "rangeStrategy": "pin",
      "groupName": "published engine crates"
    }
  ]
}
